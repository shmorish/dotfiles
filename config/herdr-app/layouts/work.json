{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "projects"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "work-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "#19172466",
      "resizable": false,
      "border": {
        "width": 1,
        "color": "#e0def41f"
      },
      "radius": 16,
      "shadow": "lg"
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "work-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true,
          "background": "#19172466",
          "border": {
            "width": 1,
            "color": "#e0def41f"
          },
          "radius": 16
        },
        {
          "id": "office",
          "type": "block",
          "content": {
            "mod": "moe-office",
            "props": {
              "lang": "ja"
            }
          },
          "size": {
            "px": 220
          },
          "min": 170,
          "max": 520,
          "background": "#19172466",
          "border": {
            "width": 1,
            "color": "#e0def41f"
          },
          "radius": 16
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#191724d9",
                  "border": {
                    "width": 1,
                    "color": "#e0def414"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 16,
                  "gap": 10,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "board",
                      "type": "block",
                      "content": {
                        "mod": "board"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": "#19172466",
              "border": {
                "width": 1,
                "color": "#e0def41f"
              },
              "radius": 16,
              "shadow": "lg"
            }
          ],
          "gap": 10
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "claude-limits",
              "type": "block",
              "content": {
                "mod": "claude-limits"
              },
              "size": {
                "px": 270
              }
            }
          ],
          "background": "#19172466",
          "border": {
            "width": 1,
            "color": "#e0def41f"
          },
          "radius": 12
        }
      ],
      "resizable": false,
      "gap": 10
    }
  ],
  "background": {
    "image": "mods/herdr-glass-bg/presets/violet.jpg",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    24,
    26
  ],
  "colors": {
    "canvas": "#00000000",
    "chrome": "#00000000",
    "background": "#19172400",
    "surface": "#1f1d2ef7",
    "raised": "#e0def41c",
    "hover": "#e0def41a",
    "selected": "#e0def424",
    "border": "#e0def426",
    "popover": "#1f1d2eeb"
  },
  "terminal_opacity": 0,
  "padding": 10,
  "gap": 10
}
