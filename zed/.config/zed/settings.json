// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "auto_install_extensions": {
    "vscode-great-icons": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Great Icons Theme",
    "dark": "VSCode Great Icons Theme"
  },
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "fast": true,
        "mode": "bypassPermissions",
        "model": "sonnet"
      },
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "auto_indent": "syntax_aware",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "scrollbar": {
    "show": "never"
  },
  "project_panel": {
    "dock": "left",
    "default_width": 360
  },
  "agent": {
    "dock": "right"
  },
  "relative_line_numbers": "enabled",
  "cursor_shape": "block",
  "inlay_hints": {
    "enabled": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "terminal": {
    "font_family": "Hack Nerd Font Mono"
  },
  "languages": {
    "JavaScript": { "tab_size": 2 },
    "TypeScript": { "tab_size": 2 },
    "TSX": { "tab_size": 2 },
    "JSON": { "tab_size": 2 },
    "JSONC": { "tab_size": 2 },
    "YAML": { "tab_size": 2 },
    "HTML": { "tab_size": 2 },
    "CSS": { "tab_size": 2 },
    "Markdown": { "tab_size": 2 },
    "Python": { "tab_size": 4 },
    "Rust": { "tab_size": 4 },
    "Go": { "tab_size": 4 },
    "C": { "tab_size": 4 },
    "C++": { "tab_size": 4 },
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
