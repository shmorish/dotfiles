.idea/
.vscode/
.DS_Store
oh-my-zsh/

# nvim swap files
*.swp
nvim/.config/nvim/undo/*
!nvim/.config/nvim/undo/.gitkeep

# karabiner auto-generated backups
karabiner/.config/karabiner/automatic_backups/

# herdr runtime files (in case of stow dir-folding on fresh machines)
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
