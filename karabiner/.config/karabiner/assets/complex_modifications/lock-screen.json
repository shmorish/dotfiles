{
  "title": "Lock Screen",
  "rules": [
    {
      "description": "Option+L to Lock Screen (macOS 10.13+)",
      "manipulators": [
        {
          "from": {
            "key_code": "l",
            "modifiers": {
              "mandatory": [
                "option"
              ]
            }
          },
          "to": [
            {
              "key_code": "q",
              "modifiers": [
                "left_control",
                "left_command"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
